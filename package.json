{
  "name": "scroll-direction-manager",
  "version": "2.3.0",
  "description": "A utility package that simplifies tracking the scroll direction (up, down, or initial) of a web page, with React hook support",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "dist/cjs/react.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:cjs": "tsc --project tsconfig.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && node scripts/finalize-build.js",
    "prepublishOnly": "npm test && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masaroli/scroll-direction-manager.git"
  },
  "keywords": [
    "scroll",
    "scroll-direction",
    "react",
    "react-hooks",
    "use-scroll-direction"
  ],
  "author": "Martin Sazzaroli",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/masaroli/scroll-direction-manager/issues"
  },
  "homepage": "https://github.com/masaroli/scroll-direction-manager#readme",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.1.3",
    "typescript": "^5.4.5"
  },
  "dependencies": {}
}
